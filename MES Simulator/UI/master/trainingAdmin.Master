<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="trainingAdmin.master.cs" Inherits="MES_TRAINING.UI.master.trainingAdmin" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MES SIMULATOR - Dashboard</title>
    <link rel="shortcut icon" href="https://d8ejoa1fys2rk.cloudfront.net/5.0.5/includes/img/icons/philips.ico">
    <link href="css/bootstrap.min.css" rel="stylesheet" />
    <link href="css/bootstrap-icons.css" rel="stylesheet" />
    <link href="css/bootstrap-table.min.css" rel="stylesheet" />
    <link href="css/myAdminStyles.css" rel="stylesheet" />
    
    <script src="<%=ResolveClientUrl("~/UI/master/js/jquery-3.6.0.js") %>"></script>
    <script src="<%=ResolveClientUrl("~/UI/master/js/bootstrap.bundle.min.js") %>"></script>
    <script src="<%=ResolveClientUrl("~/UI/master/js/bootstrap-table.min.js") %>"></script>
    <script src="<%=ResolveClientUrl("~/UI/master/js/bootstrap-table-export.min.js") %>"></script>
    <script src="<%=ResolveClientUrl("~/UI/master/js/sweetalert2.all.min.js") %>"></script>
  
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-light ">
    
   <section class="row">
           <!-- Header -->
    <div class="top-header d-flex align-items-center justify-content-between shadow-sm  col-12 row">
  <!--Header buttons-->
        <div class="col-3 col-md-2 d-flex gap-2 justify-content-end">
            <!-- Guide button-->      
            <a class="header-btn btn text-white"href="https://share.philips.com/:w:/r/sites/DigitalFactory-CostaRica/Shared%20Documents/General/Projects%20%26%20Documentation/MES%20Simulator/Manual%20Usuario%20-%20SimulatorMES.docx?d=wb19f9abf9b0e4887bc14587d6fa05cea&csf=1&web=1&e=Mty3Jl"target="_blank">
                <i class="bi bi-question-circle"></i>
            </a>    
              <!-- Toggle Button-->
<button class="header-btn btn text-white" id="sidebarToggle">
    <i class="bi bi-list"></i>
</button>
        </div>
        <div class="header-content text-center col-9">
            <h1 class="mb-0 fs-4 fw-bold">MES Simulator Admin</h1>
           
        </div>
        
        <!-- User Avatar Dropdown -->
        <div class="user-dropdown position-relative col-1 d-flex justify-content-end">
            <div class="user-avatar rounded-circle d-flex align-items-center justify-content-center fw-semibold" id="userAvatar">
                <i class="bi bi-person-circle fs-4"></i>
            </div>
            <div class="dropdown-menu-custom bg-white rounded shadow" id="userDropdown">
                
                <a href="#" class="logout-link d-flex align-items-center p-3 text-decoration-none text-danger" id="logoutLink">
                    <i class="bi bi-box-arrow-right me-2"></i>
                    Cerrar Sesión
                </a>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="sidebar shadow col-3 col-md-2" id="sidebar">
   
        <ul class="sidebar-menu d-flex flex-column gap-1">
             <li>
                 <asp:HyperLink ID="HyperLink1" CssClass="item-link d-flex align-items-center p-3 px-4" runat="server" NavigateUrl="~/UI/DashboardAdmin/home.aspx">
        
               <i class="bi bi-house  me-2 fs-5"></i>
                <span>Home</span>
            
                      </asp:HyperLink>
            </li>
            <li>
                 <asp:HyperLink ID="HyperLink2" CssClass="item-link d-flex align-items-center p-3 px-4" runat="server" NavigateUrl="~/UI/DashboardAdmin/Users.aspx">
                    <i class="bi bi-people-fill me-2 fs-5"></i>
                    <span>Usuarios</span>
                
                     </asp:HyperLink>
            </li>
        </ul>
    </div>

  

    <form id="form1" runat="server" class="col-12   col-md-10 ">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </form>
   </section>

    <script>

 
        

        // Toggle sidebar on mobile
        document.getElementById('sidebarToggle').addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('active');
            document.getElementById('form1').classList.toggle('col-md-12');

        });

        // User dropdown functionality
        const userAvatar = document.getElementById('userAvatar');
        const userDropdown = document.getElementById('userDropdown');

        userAvatar.addEventListener('click', function (e) {
            e.stopPropagation();
            userDropdown.classList.toggle('show');
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function (e) {
            if (!userDropdown.contains(e.target) && !userAvatar.contains(e.target)) {
                userDropdown.classList.remove('show');
            }
        });

        // Logout confirmation
        document.getElementById('logoutLink').addEventListener('click', function (e) {
            e.preventDefault();
            Swal.fire({
                title: '¿Cerrar sesión?',
                text: '¿Estás seguro que deseas cerrar sesión?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#315762',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, cerrar sesión',
                cancelButtonText: 'Cancelar',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    sessionStorage.clear()
                    window.location.href="/MESSimulator/loginAdmin.aspx";
                }
            });
        });
    </script>
</body>
</html>