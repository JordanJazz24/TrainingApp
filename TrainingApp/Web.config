<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
	<!-- La cadena "Default" vive en connectionStrings.config, que no se versiona (auditoría
	     AUD-04). Plantilla: connectionStrings.config.example en esta misma carpeta. -->
	<connectionStrings configSource="connectionStrings.config" />
	<system.web>
		<!-- optimizeCompilations: tras un rebuild solo se recompila el markup que cambió, no todo
		     (Login tras un rebuild: de ~4 s a ~2 s). Si después de cambiar la firma de algo que usa
		     el markup aparece un error raro en runtime, borrar "%TEMP%\Temporary ASP.NET Files\vs";
		     la precompilación con aspnet_compiler lo detecta antes. Release lo quita
		     (Web.Release.config). -->
		<compilation debug="true" targetFramework="4.7.2" optimizeCompilations="true" />
		<httpRuntime targetFramework="4.7.2" />
		<!-- Globalization: UTF-8 + cultura Costa Rica -->
		<globalization requestEncoding="utf-8"
					   responseEncoding="utf-8"
					   fileEncoding="utf-8"
					   culture="es-CR"
					   uiCulture="es-CR" />
		<authentication mode="Forms">
			<forms loginUrl="~/Pages/Auth/Login.aspx" timeout="60" slidingExpiration="true" />
		</authentication>
		<!-- Misma duración que el login: la orden simulada y el avance de DC/Assembly viven en
		     la Session; con el default de 20 min se perdían a mitad de una evaluación (auditoría
		     AUD-12). -->
		<sessionState timeout="60" />
		<authorization>
			<deny users="?" />
		</authorization>
		<pages>
			<namespaces>
				<add namespace="System.Web.Optimization" />
			</namespaces>
			<controls>
				<add assembly="Microsoft.AspNet.Web.Optimization.WebForms" namespace="Microsoft.AspNet.Web.Optimization.WebForms" tagPrefix="webopt" />
			</controls>
		</pages>
	</system.web>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" />
				<bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
				<bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
	<system.codedom>
		<compilers>
			<compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
			<compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
		</compilers>
	</system.codedom>
	<!-- Login y cambio de contraseña únicos (spec 016, D-62): abiertos a anónimos para evitar el
	     bucle de redirección; cada página revisa lo suyo. -->
	<location path="Pages/Auth">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<!-- Módulo administrativo (spec 013): solo el rol Administrator (lo arma Global.asax). Un
	     request sin sesión cae en el login único (spec 016, D-62); un operador autenticado vuelve
	     a su inicio. La BLL lo verifica otra vez (UserAdminService). -->
	<location path="Pages/Admin">
		<system.web>
			<authorization>
				<allow roles="Administrator" />
				<deny users="*" />
			</authorization>
		</system.web>
	</location>
	<!-- Entrenamiento (spec 013): solo el rol Operator. Un admin cae en el login, que con
	     sesión lo manda a su módulo. Las páginas lo revisan otra vez (SessionHelper.CanTrain). -->
	<location path="Pages/Training">
		<system.web>
			<authorization>
				<allow roles="Operator" />
				<deny users="*" />
			</authorization>
		</system.web>
	</location>
	<!-- Bundles de Site.Master (JS en /bundles y, en Release, CSS en /Content/css): Login y
	     ChangePassword los cargan antes de autenticarse. Con deny users="?" se redirigían al
	     login y el navegador recibía el HTML del Login en vez de JS/CSS. -->
	<location path="bundles">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="Content">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
</configuration>