<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicación del MVP a una carpeta (Fase 9, E1). La carpeta se le pasa a TI con Database/ y
  docs/deploy.md (D-133).

  Release aplica Web.Release.config: sin debug ni optimizeCompilations, con customErrors.
  Precompilado y no actualizable: el primer request no compila nada (arranque en frío de
  ~18 s en desarrollo) y el servidor no lleva el markup editable.
  connectionStrings.config no se publica (no está en el proyecto): lo crea TI.

  Desde Visual Studio: Publicar → MVP. Desde la terminal, en la raíz del repo:
    & "C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Current\Bin\MSBuild.exe" "TrainingApp\TrainingApp.csproj" /p:DeployOnBuild=true /p:PublishProfile=MVP /p:Configuration=Release /v:minimal /nologo
  Salida: publish\MVP en la raíz del repo (publish/ está en .gitignore).
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>False</LaunchSiteAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <publishUrl>$(MSBuildProjectDirectory)\..\publish\MVP</publishUrl>
    <DeleteExistingFiles>True</DeleteExistingFiles>
    <PrecompileBeforePublish>True</PrecompileBeforePublish>
    <EnableUpdateable>False</EnableUpdateable>
    <DebugSymbols>False</DebugSymbols>
    <ExcludeGeneratedDebugSymbol>True</ExcludeGeneratedDebugSymbol>
    <WDPMergeOption>DonotMerge</WDPMergeOption>
  </PropertyGroup>
</Project>
