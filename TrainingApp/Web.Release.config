<?xml version="1.0" encoding="utf-8"?>

<!-- For more information on using web.config transformation visit https://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    In the example below, the "SetAttributes" transform will change the value of 
    "connectionString" to use "ReleaseSQLServer" only when the "Match" locator 
    finds an attribute "name" that has a value of "MyDB".
    
    <connectionStrings>
      <add name="MyDB" 
        connectionString="Data Source=ReleaseSQLServer;Initial Catalog=MyReleaseDB;Integrated Security=True" 
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  -->
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug,optimizeCompilations)" />
    <!-- Versión de prueba (T1, parte mínima de AUD-28): fuera del servidor, un error muestra la
         página genérica de ASP.NET, sin stack trace ni detalle (ej. HttpRequestValidationException). -->
    <customErrors mode="RemoteOnly" xdt:Transform="Insert" />
    <!-- Cookies solo por HTTPS (AUD-28, AUD-72): descomentar solo cuando
         https://crapps.philips.com/ responda y http:// redirija a https://, comprobado con
         curl -I antes de publicar (D-350). Sin HTTPS, el navegador no las envía y el login
         entra en loop (pasó el 2026-11-03: el servidor no tiene certificado).
    <httpCookies requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />
    <authentication>
      <forms requireSSL="true" xdt:Transform="SetAttributes(requireSSL)" />
    </authentication>
    -->
    <!--
      In the example below, the "Replace" transform will replace the entire 
      <customErrors> section of your web.config file.
      Note that because there is only one customErrors section under the 
      <system.web> node, there is no need to use the "xdt:Locator" attribute.
      
      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
  </system.web>
  <system.webServer>
    <!-- Sin cabecera Server (D-144): TI confirmó IIS 10, que sí soporta removeServerHeader. -->
    <security xdt:Transform="Insert">
      <requestFiltering removeServerHeader="true" />
    </security>
    <!-- HSTS (AUD-80): descomentar junto con los requireSSL de arriba (D-350). max-age corto
         para empezar; sin includeSubDomains ni preload (el dominio es de TI).
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=300"
             xdt:Transform="Insert" />
      </customHeaders>
    </httpProtocol>
    -->
  </system.webServer>
</configuration>