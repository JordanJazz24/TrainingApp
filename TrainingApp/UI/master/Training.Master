<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Training.master.cs"
    Inherits="TrainingApp.UI.Master.TrainingMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - MES Training</title>

    <link href="<%=ResolveUrl("~/Content/bootstrap.min.css")%>" rel="stylesheet" />
    <link href="<%=ResolveUrl("~/UI/master/pod.css")%>"          rel="stylesheet" />

    <%-- Bootstrap and SweetAlert2 in <head> so RegisterStartupScript can use them --%>
    <script src="<%=ResolveUrl("~/Scripts/jquery-3.7.0.min.js")%>"></script>
    <script src="<%=ResolveUrl("~/Scripts/bootstrap.bundle.min.js")%>"></script>
    <script src="<%=ResolveUrl("~/Scripts/sweetalert2.all.min.js")%>"></script>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
    <script>
    // Moves the modal to the <form> element before showing it.
    // Reason: position:fixed ancestors create CSS stacking contexts that trap
    // Bootstrap's modal z-index (1050) below the backdrop z-index (1040 at root).
    // The <form> has no position/z-index, so the modal escapes the trapped context.
    // Moving to <form> (not <body>) keeps the modal's buttons inside the form,
    // which is required for ASP.NET PostBack to work.
    function showModalSafe(modalId) {
        var m = document.getElementById(modalId);
        if (!m) return;
        var form = document.forms[0];
        var target = form || document.body;
        if (m.parentElement !== target) target.appendChild(m);
        (bootstrap.Modal.getInstance(m) || new bootstrap.Modal(m)).show();
    }

    // Oculta un mensaje del MES después de ms (spec 010, P-5). Si la guía de Guided lo va a
    // mostrar en un subpaso informativo, espera: lo oculta la guía cuando el operador presiona
    // "Continuar" (R9). Un mensaje que la guía no usa se oculta como siempre.
    function podAutoHide(selector, ms) {
        setTimeout(function hide() {
            var el = document.querySelector(selector);
            if (!el) return;
            if (window.PodGuide && window.PodGuide.holds(el)) { setTimeout(hide, 500); return; }
            el.style.display = 'none';
        }, ms);
    }

    // Banner de error del MES del POD (spec 017, superficie B): una fila por texto, como texto
    // plano; [] lo oculta. Va en el head para que RegisterStartupScript lo pueda llamar. Con un
    // error a la vista, el banner de éxito (.pod-banner) se oculta: nunca se apilan.
    // help: la explicación en español (solo Práctica libre); null sin ella.
    function podShowMesErrors(texts, help) {
        var zone = document.getElementById('podMesError');
        if (!zone) return;
        zone.textContent = '';
        texts.forEach(function (t) {
            var row  = document.createElement('div');
            var icon = document.createElement('span');
            var text = document.createElement('span');
            row.className  = 'mes-error-row';
            icon.className = 'mes-error-icon';
            icon.setAttribute('aria-hidden', 'true');
            text.textContent = t;
            row.appendChild(icon);
            row.appendChild(text);
            zone.appendChild(row);
            if (help) podAttachMesHelp(row, help);
        });
        zone.style.display = texts.length ? '' : 'none';
        var success = document.querySelector('.pod-banner');
        if (success && texts.length) success.style.display = 'none';
    }

    // Botón "¿Qué significa?" al final de un mensaje del MES (spec 017, D-102; elección del
    // usuario al probar la E4): en Práctica libre abre un aviso de información con el mensaje
    // y su explicación en español. Texto plano (textContent).
    function podAttachMesHelp(el, help) {
        if (!el || !help || el.querySelector('.mes-help-btn')) return;
        var message = el.textContent.trim();
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'mes-help-btn';
        var icon = document.createElement('span');
        icon.className = 'mes-help-ico';
        icon.setAttribute('aria-hidden', 'true');
        icon.textContent = 'i';
        btn.appendChild(icon);
        var label = document.createElement('span');
        label.textContent = '¿Qué significa?';
        btn.appendChild(label);
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            podShowMesHelp(message, help);
        });
        el.appendChild(btn);
    }

    function podShowMesHelp(message, help) {
        var box  = document.createElement('div');
        var mes  = document.createElement('div');
        var text = document.createElement('p');
        box.className  = 'mes-help-dialog';
        mes.className  = 'mes-help-dialog-mes';
        mes.textContent  = message;
        text.textContent = help;
        box.appendChild(mes);
        box.appendChild(text);
        Swal.fire({ titleText: '¿Qué significa?', html: box, icon: 'info', confirmButtonText: 'Entendido' });
    }

    // Explicación de un mensaje del MES que mostró un chequeo del cliente (spec 017, D-102):
    // en Guided, la nota de la guía; en Práctica libre, el (?) sobre su superficie (en el
    // banner, en cada fila). La página deja en window.podMesNotes solo lo que el modo recibe
    // (Assessment, nada).
    function podNoteMesError(id) {
        var n = window.podMesNotes && window.podMesNotes[id];
        if (!n) return;
        if (n.html && window.PodGuide && window.PodGuide.note) window.PodGuide.note(n.anchor, n.html);
        if (n.plain) {
            var surface = document.querySelector('[data-guide="' + n.anchor + '"]');
            if (!surface) return;
            var rows = surface.querySelectorAll('.mes-error-row');
            if (rows.length) rows.forEach(function (r) { podAttachMesHelp(r, n.plain); });
            else podAttachMesHelp(surface, n.plain);
        }
    }

    // [↗] de la barra de título estándar de los modales del MES: maximiza o restaura
    // el modal. Es estado de cliente; un postback lo devuelve a su tamaño normal.
    function mesToggleMaximize(btn) {
        var dialog = btn.closest('.modal-dialog');
        if (dialog) dialog.classList.toggle('modal-fullscreen');
    }

    // Modales apilados (ej. Data Collection Entry sobre Data Collection Standalone): Bootstrap
    // abre todos al mismo nivel, así que el hijo sube de z-index y su velo queda entre el
    // padre y el hijo (padre 1055 → velo 1057, hijo 1058; SweetAlert sigue arriba, 1060).
    // Se lleva una pila propia porque, tras un postback, el padre y el hijo se abren seguidos
    // y el padre todavía no tiene la clase .show cuando se abre el hijo.
    (function () {
        var stack = [];
        document.addEventListener('show.bs.modal', function (e) {
            var modal = e.target, depth = stack.length;
            stack.push(modal);
            if (depth === 0) return;
            var z = 1056 + depth * 2;
            modal.style.zIndex = z;
            modal.classList.add('mes-stacked');
            setTimeout(function () {
                var backdrops = document.querySelectorAll('.modal-backdrop');
                var last = backdrops[backdrops.length - 1];
                if (last) { last.style.zIndex = z - 1; last.classList.add('mes-stacked-backdrop'); }
            }, 0);
        });
        document.addEventListener('hidden.bs.modal', function (e) {
            var i = stack.indexOf(e.target);
            if (i >= 0) stack.splice(i, 1);
            e.target.style.zIndex = '';
            e.target.classList.remove('mes-stacked');
        });
    })();
    </script>
</head>
<body>
<form id="MainForm" runat="server">
    <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePartialRendering="false">
        <Scripts>
            <asp:ScriptReference Name="WebForms.js" Assembly="System.Web"
                Path="~/Scripts/WebForms/WebForms.js" />
        </Scripts>
    </asp:ScriptManager>

    <asp:ContentPlaceHolder ID="MainContent" runat="server" />

</form>
<asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
</body>
</html>
