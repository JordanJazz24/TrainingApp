<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="TrainingApp.SiteMaster" %>
<%-- Inicio del operador (StartSession) con el sistema de diseño de la Fase 11 (admin.css,
     D-163): la barra con el nombre de la app, el tema, el usuario y Cerrar sesión. El POD usa
     Training.Master, que no recibe el tema. --%>
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Simulador de entrenamiento MES</title>

    <%-- Tema claro u oscuro antes de pintar (D-157); el POD no lo carga. --%>
    <script src="<%=ResolveUrl("~/UI/master/theme.js")%>"></script>

    <link href="<%=ResolveUrl("~/Content/bootstrap.min.css")%>" rel="stylesheet" />
    <link href="<%=ResolveUrl("~/Content/bootstrap-icons-1.13.2/bootstrap-icons.min.css")%>" rel="stylesheet" />
    <link href="<%=ResolveUrl("~/UI/master/admin.css")%>" rel="stylesheet" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>
<body class="mt-page">
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <header class="admin-bar">
            <a class="admin-brand text-decoration-none" runat="server" href="~/Pages/Training/StartSession.aspx">
                <i class="bi bi-display" aria-hidden="true"></i>Simulador de entrenamiento MES</a>

            <div class="admin-bar-end">
                <%-- El texto dice a qué modo cambia; theme.js lo ajusta al tema actual. --%>
                <button type="button" id="mtThemeToggle" class="btn btn-secondary btn-sm"
                    aria-label="Cambiar a modo oscuro">
                    <i class="bi bi-moon" aria-hidden="true"></i><span>Oscuro</span>
                </button>
                <asp:PlaceHolder ID="PhUser" runat="server" Visible="false">
                    <div class="admin-user">
                        <span class="admin-user-code"><asp:Literal ID="LitUser" runat="server" /></span>
                        <span class="admin-user-last"><asp:Literal ID="LitUserCode1" runat="server" /></span>
                    </div>
                    <%-- Salir sin cerrar el navegador (auditoría D-13): en una PC compartida el
                         siguiente operador no debe entrenar con esta identidad. --%>
                    <asp:LinkButton ID="BtnLogout" runat="server" CssClass="btn btn-secondary btn-sm"
                        CausesValidation="false" OnClick="BtnLogout_Click">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>Cerrar sesión</asp:LinkButton>
                </asp:PlaceHolder>
            </div>
        </header>

        <main class="admin-main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>
    </form>
</body>
</html>
