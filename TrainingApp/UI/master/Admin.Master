<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs"
    Inherits="TrainingApp.UI.Master.AdminMaster" %>
<%-- Diseño neutro con el sistema de diseño de la Fase 11 (admin.css, brief 019), sin el marco
     del MES ni el de SAP NetWeaver (esos son parte de la simulación). Lo usan el login y el
     cambio de contraseña únicos de la app (spec 016, D-62), el dashboard (spec 018) y la
     gestión de usuarios (spec 013). Solo este master recibe el modo oscuro (D-157). --%>
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - TrainingApp</title>

    <%-- Tema claro u oscuro antes de pintar (D-157); el POD no lo carga. --%>
    <script src="<%=ResolveUrl("~/UI/master/theme.js")%>"></script>

    <link href="<%=ResolveUrl("~/Content/bootstrap.min.css")%>" rel="stylesheet" />
    <link href="<%=ResolveUrl("~/Content/bootstrap-icons-1.13.2/bootstrap-icons.min.css")%>" rel="stylesheet" />
    <link href="<%=ResolveUrl("~/UI/master/admin.css")%>" rel="stylesheet" />

    <%-- SweetAlert2 en <head> para que los mensajes de RegisterStartupScript lo encuentren --%>
    <script src="<%=ResolveUrl("~/Scripts/sweetalert2.all.min.js")%>"></script>
</head>
<body class="mt-page">
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%-- jquery + WebUIValidation: validadores de formato en el cliente --%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <%-- Barra superior (spec 022, brief 0, propuesta 1): la misma de Site.Master, en el azul
             del Login. El login y el cambio de contraseña van a pantalla completa, sin ella
             (FullBleed) y con su propio #mtThemeToggle. La clase is-open del menú plegado la
             pone theme.js (cliente, sin postback). --%>
        <header class="mt-topbar is-admin" runat="server" id="AdminBar">
            <span class="mt-topbar-brand">
                <span class="mt-topbar-mark"><i class="bi bi-display" aria-hidden="true"></i></span>
                <span class="mt-topbar-brand-text">TrainingApp</span>
            </span>

            <%-- Menú del dashboard (spec 018) en dos grupos: Dashboard (Resumen · Operadores ·
                 Pasos · Seguimiento) y Administración (Usuarios · Guías, spec 020). Solo con
                 CanViewReports (este master también lo usan el login y el cambio de
                 contraseña). Debajo de 1200 px se pliega en el botón Menú, que dice la vista
                 actual. --%>
            <asp:PlaceHolder ID="PhMenu" runat="server" Visible="false">
                <button type="button" id="mtTopbarMenu" class="mt-topbar-btn mt-topbar-menu"
                    aria-expanded="false" aria-controls="mtTopbarNav">
                    <i class="bi bi-list" aria-hidden="true"></i><span class="mt-topbar-menu-k">Menú</span>
                    <span class="mt-topbar-current"><asp:Literal ID="LitCurrent" runat="server" /></span>
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </button>
                <nav class="mt-topbar-nav" id="mtTopbarNav" aria-label="Administración">
                    <div class="mt-topbar-group">
                        <span class="mt-topbar-gk" id="mtNavDashboard">Dashboard</span>
                        <ul class="mt-topbar-seg" aria-labelledby="mtNavDashboard">
                            <li><asp:HyperLink ID="LnkSummary" runat="server"
                                NavigateUrl="~/Pages/Admin/Summary.aspx">Resumen</asp:HyperLink></li>
                            <li><asp:HyperLink ID="LnkOperators" runat="server"
                                NavigateUrl="~/Pages/Admin/Operators.aspx">Operadores</asp:HyperLink></li>
                            <li><asp:HyperLink ID="LnkSteps" runat="server"
                                NavigateUrl="~/Pages/Admin/Steps.aspx">Pasos</asp:HyperLink></li>
                            <li><asp:HyperLink ID="LnkFollowUp" runat="server"
                                NavigateUrl="~/Pages/Admin/FollowUp.aspx">Seguimiento</asp:HyperLink></li>
                        </ul>
                    </div>
                    <asp:PlaceHolder ID="PhAdminGroup" runat="server">
                        <div class="mt-topbar-group">
                            <span class="mt-topbar-gk" id="mtNavAdmin">Administración</span>
                            <ul class="mt-topbar-seg" aria-labelledby="mtNavAdmin">
                                <li><asp:HyperLink ID="LnkUsers" runat="server"
                                    NavigateUrl="~/Pages/Admin/Users.aspx">Usuarios</asp:HyperLink></li>
                                <%-- Spec 020: el tipo de Resource Setup de cada guía. --%>
                                <li><asp:HyperLink ID="LnkGuides" runat="server"
                                    NavigateUrl="~/Pages/Admin/Guides.aspx">Guías</asp:HyperLink></li>
                            </ul>
                        </div>
                    </asp:PlaceHolder>
                </nav>
            </asp:PlaceHolder>

            <div class="mt-topbar-end">
                <%-- El texto dice a qué modo cambia; theme.js lo ajusta al tema actual (lee el
                     único <span> del botón). --%>
                <button type="button" id="mtThemeToggle" class="mt-topbar-btn"
                    aria-label="Cambiar a modo oscuro">
                    <i class="bi bi-moon" aria-hidden="true"></i><span>Oscuro</span>
                </button>
                <asp:PlaceHolder ID="PhUser" runat="server" Visible="false">
                    <%-- Se ve antes del tema (order en admin.css). Nombre y último acceso; el
                         title los repite cuando la barra los oculta. --%>
                    <div class="mt-topbar-account" runat="server" id="UserAccount">
                        <span class="mt-topbar-avatar" aria-hidden="true"><asp:Literal ID="LitInitials" runat="server" /></span>
                        <span class="mt-topbar-who">
                            <span class="mt-topbar-name"><asp:Literal ID="LitUser" runat="server" /></span>
                            <span class="mt-topbar-sub"><asp:Literal ID="LitLastLogin" runat="server" /></span>
                        </span>
                    </div>
                    <asp:LinkButton ID="BtnLogout" runat="server" CssClass="mt-topbar-btn"
                        CausesValidation="false" OnClick="BtnLogout_Click" ToolTip="Cerrar sesión">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Cerrar sesión</span></asp:LinkButton>
                </asp:PlaceHolder>
            </div>
        </header>

        <main class="admin-main" runat="server" id="AdminMain">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>
    </form>

    <%-- Scripts de cada página, después del contenido (ej. Chart.js en las vistas con gráficas,
         spec 018: <script src="~/Scripts/chart-4.5.1.umd.min.js">). --%>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
</body>
</html>
