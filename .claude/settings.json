{
  "extraKnownMarketplaces": {
    "dotnet-claude-kit": {
      "source": {
        "source": "github",
        "repo": "codewithmukesh/dotnet-claude-kit"
      }
    }
  },
  "enabledPlugins": {
    "dotnet-claude-kit@dotnet-claude-kit": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.ps1\""
          }
        ]
      }
    ]
  }
}
